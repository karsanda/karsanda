# Copy to local/weave.env (gitignored) and fill in.
# Loaded by scripts/publish.sh and by the systemd unit. Quote values that contain spaces.

# Base URL of the GitLab REST API, e.g. https://gitlab.example.com/api/v4
GITLAB_API_URL=

# Optional script, sourced when GITLAB_TOKEN is empty, that may export GITLAB_TOKEN
# from a credential that already exists. It must never create one.
WEAVE_CREDENTIAL_HOOK=

# Optional messages: shown when no token is set, and in the desktop alert when GitLab data goes stale.
WEAVE_TOKEN_HINT=
WEAVE_STALE_HINT=

# systemd starts with a minimal PATH: node, gh and git must all resolve from this one.
PATH=
